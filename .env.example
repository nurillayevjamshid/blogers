# Server-only Supabase credentials. Never put the service role key in VITE_* variables.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Backward-compatible alias; service role key is preferred.
SUPABASE_SECRET_KEY=""
# Optional client key (not used by the server when service role key exists).
SUPABASE_PUBLISHABLE_KEY=""
AUTH_TOKEN_SECRET="generate-a-long-random-server-secret"

# Runtime
PORT="3000"
NODE_ENV="development"
